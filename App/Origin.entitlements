<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What a package-source manager needs that an App Store app can never have.
  Apple's signing infrastructure will not grant these, which is why the app ships
  unsigned in a .deb and is signed on the device by `ldid -SOrigin.entitlements`.

  - platform-application
    Marks the binary as a platform binary. Without it amfid refuses to run a
    binary carrying the sandbox-bypass keys below and the app dies at launch.
  - com.apple.private.security.no-container / container-required = false
    Run outside the app data container: the sources files live in /var/jb/etc/apt
    or /etc/apt, and so does the helper being executed.
  - com.apple.private.security.storage.var
    Required on rootless jailbreaks, where everything Origin touches is on /var.
  - run-unsigned-code
    The helper is signed ad hoc, not by Apple; exec'ing it is refused without
    this on jailbreaks that check.
  - task_for_pid-allow
    Looking at the helper's process is the difference between a write that
    failed and one that failed silently.
  - get-task-allow
    So a debugger can attach to a Debug build on device.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.var</key>
	<true/>
	<key>run-unsigned-code</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>get-task-allow</key>
	<true/>

	<!-- Without these securityd refuses every keychain operation from an ad-hoc
	     signed app; nothing here uses the keychain today, but the group has to be
	     the app's own bundle id so nothing else can read it if it ever does. -->
	<key>application-identifier</key>
	<string>com.r0gueee.origin</string>
	<key>keychain-access-groups</key>
	<array>
		<string>com.r0gueee.origin</string>
	</array>
	<key>com.apple.developer.team-identifier</key>
	<string>R0GUEEE</string>
</dict>
</plist>
